# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# New API keys (Supabase dashboard → Project Settings → API Keys → "Publishable and secret API keys" tab)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rentanje.com
# For local dev use: http://localhost:3000

# ── Resend (Email) ────────────────────────────────────────────
RESEND_API_KEY=re_...
# All emails sent from this address (list360.agency domain verified in Resend)
FROM_EMAIL=mail@list360.agency
# Where new inquiry notifications are delivered
ADMIN_EMAIL=info@rentanje.com

# ── Analytics ─────────────────────────────────────────────────
# Google Analytics 4 — leave empty to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Maps ───────────────────────────────────────────────
# Browser API key for the JS store-locator map. Leave EMPTY to disable —
# the current contact-page map uses keyless iframe embeds and needs no key.
# A browser Maps key is ALWAYS visible client-side; security comes from
# restrictions in Google Cloud Console, NOT secrecy. When creating the key:
#   • Application restriction → HTTP referrers:
#       https://rentanje.com/*  https://*.rentanje.com/*  http://localhost:3000/*
#   • API restrictions → Maps JavaScript API + Places API only
# Console: https://console.cloud.google.com/google/maps-apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
